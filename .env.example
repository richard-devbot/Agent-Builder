# ==============================================================================
# Agent Builder — Environment Configuration (.env.example)
# Copy to .env.local for local development. All values are empty by default;
# never commit real credentials, tokens, or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Single Sign-On — Microsoft Entra ID (Auth.js / next-auth v5)
# ------------------------------------------------------------------------------
# 32+ byte secret used to encrypt Auth.js JWT session cookies (AES-256-GCM)
AUTH_SECRET=
# Application (client) ID from Microsoft Entra ID App Registration
AUTH_MICROSOFT_ENTRA_ID_ID=
# Client secret from Microsoft Entra ID App Registration
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Entra ID v2.0 OIDC Issuer URL: https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Optional local development bypass (ONLY active when NODE_ENV=development and set to "true")
AUTH_DEV_BYPASS=

# ------------------------------------------------------------------------------
# 2. GitLab OAuth 2.0 + PKCE & Repository Push (Server-side only)
# ------------------------------------------------------------------------------
# Base URL of your GitLab instance (e.g. https://gitlab.example.com)
GITLAB_BASE_URL=
# Target GitLab group path where agent repositories are created
GITLAB_GROUP_PATH=
# Contact / team name displayed if a user needs Developer role in the group
GITLAB_GROUP_OWNER_CONTACT=
# GitLab OAuth 2.0 Application Client ID (scopes: api, read_user)
GITLAB_OAUTH_CLIENT_ID=
# GitLab OAuth 2.0 Application Client Secret
GITLAB_OAUTH_CLIENT_SECRET=
# Optional explicit OAuth callback URL (defaults to <SITE_URL>/api/gitlab/callback)
GITLAB_OAUTH_REDIRECT_URI=
# 32+ character key (or 64-char hex / 44-char base64) for AES-256-GCM cookie encryption
GITLAB_TOKEN_ENC_KEY=

# ------------------------------------------------------------------------------
# 3. Discovery Agent — Google Cloud Vertex AI (Server-side only)
# ------------------------------------------------------------------------------
# Must be "true" — Gemini is accessed exclusively via Vertex AI (never API keys)
GOOGLE_GENAI_USE_VERTEXAI=
# Google Cloud project ID hosting Vertex AI for the Discovery intake agent
GOOGLE_CLOUD_PROJECT=
# Vertex AI region (e.g. global)
GOOGLE_CLOUD_LOCATION=
# Optional inline service-account JSON if not using Workload Identity / ADC
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional override for the approved Gemini model used by Discovery
GEMINI_MODEL=

# ------------------------------------------------------------------------------
# 4. Public Platform & Governance Metadata (Client + Server)
# ------------------------------------------------------------------------------
# Application display name
NEXT_PUBLIC_APP_NAME=
# Platform edition subtitle shown in header/footer
NEXT_PUBLIC_APP_EDITION=
# Organisation or company name
NEXT_PUBLIC_ORG_NAME=
# Canonical base URL of this Agent Builder deployment
NEXT_PUBLIC_SITE_URL=
# Public GitLab base URL for UI links
NEXT_PUBLIC_GITLAB_BASE_URL=
# Public GitLab target group path shown in Step 5 (Deployment Setup)
NEXT_PUBLIC_GITLAB_GROUP_PATH=
# Contact shown when a user needs Developer access to the GitLab group
NEXT_PUBLIC_GITLAB_GROUP_OWNER_CONTACT=
# Internal support portal URL
NEXT_PUBLIC_SUPPORT_URL=
# Internal access-request / ticket system URL
NEXT_PUBLIC_TICKET_SYSTEM_URL=
# Optional JSON map of system owner team contacts
NEXT_PUBLIC_OWNER_TEAM_CONTACTS=
# Optional JSON array of approved GCP regions: [{"id":"...","label":"..."}]
NEXT_PUBLIC_GCP_REGIONS=
# Optional JSON array of approved Gemini models: [{"id":"...","label":"...","note":"..."}]
NEXT_PUBLIC_APPROVED_GEMINI_MODELS=
# Optional default approved Gemini model ID
NEXT_PUBLIC_DEFAULT_GEMINI_MODEL=
# Optional JSON array of compliance options: [{"id":"...","label":"..."}]
NEXT_PUBLIC_COMPLIANCE_OPTIONS=

# ------------------------------------------------------------------------------
# 5. Cloud Environments Mapping (Read-only display in Step 5 & Step 7)
# Actual deployment credentials live in GitLab Group CI/CD variables via WIF.
# ------------------------------------------------------------------------------
# Development (dev)
NEXT_PUBLIC_GCP_DEV_PROJECT_ID=
NEXT_PUBLIC_GCP_DEV_REGION=
NEXT_PUBLIC_GCP_DEV_RUNTIME_SA=
NEXT_PUBLIC_GCP_DEV_DEFAULT_TARGET=

# User Acceptance Testing (uat)
NEXT_PUBLIC_GCP_UAT_PROJECT_ID=
NEXT_PUBLIC_GCP_UAT_REGION=
NEXT_PUBLIC_GCP_UAT_RUNTIME_SA=
NEXT_PUBLIC_GCP_UAT_DEFAULT_TARGET=

# Production (prod — restricted in UI to Approver / Admin roles)
NEXT_PUBLIC_GCP_PROD_PROJECT_ID=
NEXT_PUBLIC_GCP_PROD_REGION=
NEXT_PUBLIC_GCP_PROD_RUNTIME_SA=
NEXT_PUBLIC_GCP_PROD_DEFAULT_TARGET=
